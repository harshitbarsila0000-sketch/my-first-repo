# Copy this file to .streamlit/secrets.toml and fill in your keys.
# NEVER commit the real secrets.toml to GitHub — add it to .gitignore.
GROQ_API_KEY = "your-groq-api-key-here"

# Shared Phase 4 crypto secret used to derive AES-256-GCM and HMAC-SHA256 keys.
# Use a long, random value in real deployments, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SIF_SHARED_SECRET = "replace-with-a-long-random-shared-secret"
